# This `.xcode.env` file is versioned and is used to source the environment
# used when running script phases inside Xcode.
# To customize your local environment, you can create an `.xcode.env.local`
# file that is not versioned.

# NODE_BINARY variable contains the PATH to the node executable.
#
# Customize the NODE_BINARY variable here.
# For example, to use nvm with brew, add the following line
# . "$(brew --prefix nvm)/nvm.sh" --no-use
export NODE_BINARY=$(command -v node)

# Release builds (TestFlight, App Store) are production unless the build setting
# OLGA_BUNDLE_ENV says otherwise. The "OlgaMobile" scheme archives with Release (prod);
# the "OlgaMobile Dev" scheme archives with Release-Dev, which sets OLGA_BUNDLE_ENV to dev
# together with the matching app ID, sign-in scheme and profile. `npm run ios:archive:dev`
# does the same from the command line. Debug builds get their environment from Metro
# (OLGA_ENV, default dev).
case "$CONFIGURATION" in
  Release*) export OLGA_ENV="${OLGA_BUNDLE_ENV:-prod}" ;;
esac
